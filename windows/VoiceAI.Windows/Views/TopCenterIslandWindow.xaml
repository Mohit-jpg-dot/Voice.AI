<Window
    x:Class="VoiceAI.Windows.Views.TopCenterIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voice.AI Top Center Island">

    <Grid Background="Transparent">
        <!-- Floating Pill Border with Mica / Dark Acrylic Styling -->
        <Border x:Name="IslandBorder"
                Background="#F2121212"
                CornerRadius="22"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MinWidth="240"
                MaxWidth="680">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,Auto">
                <!-- Status Row -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#30D158" />
                        <TextBlock x:Name="StatusLabel" Text="Voice.AI" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- Elapsed Time / Model Tag -->
                    <TextBlock Grid.Column="2" x:Name="MetaBadge" Text="Offline Ready" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                </Grid>

                <!-- Transcription & Answer Row (Auto-expands dynamically) -->
                <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,8,0,4">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TranscriptText"
                                   Text=""
                                   FontSize="13"
                                   FontStyle="Italic"
                                   Foreground="#AAAAAA"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="ResponseText"
                                   Text="Hold Ctrl or click to speak..."
                                   FontSize="14"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Approval Card (Consequential actions e.g. WhatsApp, File modifications) -->
                <Border Grid.Row="2" x:Name="ApprovalCard" Background="#222222" CornerRadius="12" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ApprovalMessage" Text="Action requires confirmation:" Foreground="#FFCC00" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="ApprovalDetails" Text="" Foreground="#FFFFFF" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="BtnReject" Content="Cancel" Click="BtnReject_Click" Background="#333333" Foreground="#FFFFFF" />
                            <Button x:Name="BtnApprove" Content="Approve" Click="BtnApprove_Click" Background="#30D158" Foreground="#000000" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
