<Window
    x:Class="VoiceAI.Windows.Views.ModelSetupDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voice.AI — Model Setup &amp; Settings Dashboard"
    Width="720"
    Height="600">

    <Grid Background="#121214" Padding="28">
        <StackPanel Spacing="18">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Model Setup &amp; Settings" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Manage on-device vision, language, and voice models with zero terminal commands." FontSize="13" Foreground="#888888" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1E1E24" CornerRadius="8" Padding="12,6" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="TxtHardwareSummary" Text="16 GB RAM · 50 GB Free" Foreground="#30D158" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>

            <!-- 8GB RAM Guardrail Notice -->
            <Border x:Name="GuardrailCard" Background="#2A1B00" CornerRadius="10" BorderBrush="#FF9500" BorderThickness="1" Padding="14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="8 GB Memory Guardrail Active" FontWeight="Bold" Foreground="#FF9500" FontSize="13" />
                        <TextBlock Text="Running 7B Vision models locally on 8GB systems may cause memory pressure. We recommend Hybrid Mode (Local Brain 3B + Cloud Vision API) for lockup-free performance." Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Models List -->
            <StackPanel Spacing="12">
                <!-- 1. The Brain -->
                <Border Background="#1A1A1E" CornerRadius="10" Padding="16" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="🧠" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Llama-3.2-3B" FontWeight="Bold" Foreground="#FFFFFF" FontSize="15" />
                                <Border Background="#33007AFF" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="The Brain" Foreground="#007AFF" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Understands colloquial Hinglish/Hindi text commands &amp; breaks down multi-step goals into structured plans." Foreground="#888888" FontSize="12" />
                            <TextBlock Text="Size: ~2.5 GB · RAM Required: 3.5 GB" Foreground="#666666" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Download" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2. The Eyes -->
                <Border Background="#1A1A1E" CornerRadius="10" Padding="16" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="👁️" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Qwen2-VL-7B" FontWeight="Bold" Foreground="#FFFFFF" FontSize="15" />
                                <Border Background="#3334C759" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="The Eyes" Foreground="#34C759" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Inspects display screenshots, tracks clickable boundaries, and identifies target UI buttons via Set-of-Mark visual grounding." Foreground="#888888" FontSize="12" />
                            <TextBlock Text="Size: ~5.2 GB · RAM Required: 6.0 GB" Foreground="#666666" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Download" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. The Voice -->
                <Border Background="#1A1A1E" CornerRadius="10" Padding="16" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="🎙️" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Kokoro-82M" FontWeight="Bold" Foreground="#FFFFFF" FontSize="15" />
                                <Border Background="#33AF52DE" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="The Voice" Foreground="#AF52DE" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Ultra-fast, natural multilingual text-to-speech synthesis with zero internet lag." Foreground="#888888" FontSize="12" />
                            <TextBlock Text="Size: ~300 MB · RAM Required: Minimal" Foreground="#666666" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Download" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 1-Click Action -->
            <Button x:Name="BtnDownloadAll" Content="1-Click Download &amp; Setup All Models" HorizontalAlignment="Right" Background="#007AFF" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,10" Click="BtnDownloadAll_Click" />
            <ProgressBar x:Name="GlobalProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>

